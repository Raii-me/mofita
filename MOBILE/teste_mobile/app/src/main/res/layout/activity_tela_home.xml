<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brancoPadrao"
    android:orientation="vertical"
    tools:context=".Tela_Home">

    <include layout="@layout/component_top_sidebar"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dpAlto"
        android:layout_marginBottom="@dimen/dpAlto"
        android:background="@drawable/bg_borda_cinza"
        android:orientation="horizontal"
        android:gravity="end"
        android:padding="@dimen/dpBaixo"
        android:layout_marginTop="@dimen/dpAlto">

        <TextView android:id="@+id/txt_melhor_nota"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="@dimen/dpBaixo"
            android:textColor="@color/azulPadrao"
            android:textSize="@dimen/dpMedio"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_regular" />

        <Button
            android:layout_width="160dp"
            android:layout_height="40dp"
            android:textColor="@color/brancoPadrao"
            android:backgroundTint="@color/laranjaPadrao"
            android:text="Ver Redação"
            android:fontFamily="@font/poppins_regular"

            app:cornerRadius="@dimen/dpBaixo"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/grafico_home"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:layout_marginHorizontal="@dimen/dpAlto"
        android:background="@drawable/bg_borda_cinza"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dpAlto"
            android:fontFamily="@font/poppins_regular"
            android:text="Desempenho das Redações"
            android:textColor="@color/azulPadrao"
            android:textSize="@dimen/dpAlto" />

        <ImageView android:id="@+id/temporario_se_vira_ai_paizao"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/poppins_regular"
            android:background="@drawable/bg_borda_azul"
            android:layout_marginHorizontal="@dimen/dpBaixo"
            android:layout_marginVertical="@dimen/dpBaixo"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dpAlto"
        android:layout_marginTop="@dimen/dpAlto"
        android:background="@drawable/bg_borda_cinza"
        android:orientation="horizontal"
        android:padding="5dp">

        <TextView android:id="@+id/txt_ultima_nota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/dpBaixo"
            android:textColor="@color/azulPadrao"

            android:fontFamily="@font/poppins_regular"
            android:textSize="@dimen/dpAlto" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <CheckBox android:id="@+id/nao_sei_a_ultilidade_disso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:buttonTint="@color/azulPadrao"
            android:scaleX="1.6"
            android:scaleY="1.6" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dpAlto"
        android:layout_marginTop="@dimen/dpBaixo"
        android:gravity="center"
        android:orientation="horizontal">

        <Button android:id="@+id/btn_modelos"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:backgroundTint="@color/azulPadrao"
            android:padding="@dimen/dpMedio"
            android:text="Modelos"
            android:textColor="@color/brancoPadrao"
            android:fontFamily="@font/poppins_regular"
            android:textSize="@dimen/dpMuitoAlto"
            app:cornerRadius="@dimen/dpBaixo" />

        <Button android:id="@+id/btn_livro"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dpAlto"
            android:backgroundTint="@color/azulPadrao"
            android:padding="@dimen/dpMedio"
            android:text="Livros"
            android:textColor="@color/brancoPadrao"
            android:fontFamily="@font/poppins_regular"
            android:textSize="@dimen/dpMuitoAlto"
            app:cornerRadius="@dimen/dpBaixo" />

    </LinearLayout>

    <include layout="@layout/component_navbar" />

</LinearLayout>