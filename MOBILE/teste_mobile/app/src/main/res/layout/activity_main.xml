<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brancoPadrao"
    android:orientation="vertical"
    tools:context=".MainActivity">



    <LinearLayout
        android:gravity="center"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:orientation="vertical">


        <ImageView
            android:id="@+id/logo_inicial"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginHorizontal="30dp"
            android:src="@drawable/bg_logo_reda" />

        <Button
            android:id="@+id/btn_caminho_padrao_temp"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:layout_width="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:text="Caminho padrao" />

        <Button
            android:id="@+id/tela_home_temp"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:text="tela home" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="50dp"
            >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="30dp"
            android:fontFamily="@font/poppins_regular"

            android:gravity="center"
            android:text="from"
            android:textColor="@color/cinzaPadrao"
            android:textSize="16dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="30dp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:text="Reda+"
            android:textColor="@color/laranjaPadrao"
            android:textSize="24dp"
            android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>



</LinearLayout>


