<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brancoPadrao"
    android:orientation="vertical"
    tools:context=".Tela_Escolher_Tema">

    <include layout="@layout/component_top_voltar" />

    <TextView
        android:id="@+id/title_Configuracoes"
        style="@style/titulo_padrao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Modelos" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp"
        android:layout_marginBottom="@dimen/dpMuitoAlto"
        android:orientation="horizontal">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/campoBusca"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginRight="5dp"
            android:background="@drawable/bg_borda_cinza"
            app:iconifiedByDefault="false" />

        <Button
            android:layout_width="120dp"
            android:layout_height="55dp"
            android:layout_gravity="center"
            android:layout_marginRight="@dimen/dpAlto"
            android:backgroundTint="@color/brancoPadrao"
            android:text="Filtro"
            android:textColor="#818181"
            android:textSize="13dp"
            app:cornerRadius="@dimen/dpBaixo"
            app:strokeColor="#B8B6B6"
            app:strokeWidth="2dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/component_card_modelos" />

        <include layout="@layout/component_card_modelos" />

        <include layout="@layout/component_card_modelos" />

    </LinearLayout>

    <include layout="@layout/component_navbar" />

</LinearLayout>
